; Engine configuration file.
; Plataformero 2D — «El Registro Eterno»
;
; OJO: este fichero estuvo escrito a mano y no abria. Arreglado el 02-09-2026:
;   - faltaba config_version (Godot no lo reconocia como proyecto)
;   - los 4 primeros autoloads apuntaban a res://../../, que es imposible:
;     res:// ES la raiz del proyecto, no se puede salir de ella
;   - AudioManager y DialogueManager ya existian aqui dentro; se apunta a ellos
;   - se referenciaban icon.svg y audio_bus_layout.tres, que no existian
;   - faltaban las acciones "jump" y "shoot" que el codigo usa

config_version=5

[application]

config/name="Plataformero 2D"
run/main_scene="res://nivel_01.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[autoload]

NetworkManager="*res://codigo/NetworkManager.gd"
GameManager="*res://codigo/GameManager.gd"
AudioManager="*res://codigo/2026-03-17_audio_manager.gd"
DialogueManager="*res://narrativa/2026-03-17_dialogue_manager.gd"
SignalBus="*res://codigo/SignalBus.gd"
LevelManager="*res://codigo/LevelManager.gd"
SaveSystem="*res://codigo/SaveSystem.gd"
AchievementManager="*res://codigo/AchievementManager.gd"
DialogueTriggers="*res://codigo/DialogueTriggers.gd"

[audio]

buses/default_bus_layout="res://audio_bus_layout.tres"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1

[input]

jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
shoot={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":88,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}
